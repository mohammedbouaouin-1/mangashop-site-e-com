<script>
const autofillUser = <?= json_encode($autofillUser) ?>;

function autocompleteCheckoutDetails() {
    if (!autofillUser) return;
    const form = document.getElementById('mainCheckoutForm');
    if (!form) return;
    
    if (autofillUser.name) form.querySelector('input[name="name"]').value = autofillUser.name;
    if (autofillUser.phone) form.querySelector('input[name="phone"]').value = autofillUser.phone;
    if (autofillUser.email) form.querySelector('input[name="email"]').value = autofillUser.email;
    if (autofillUser.address) form.querySelector('input[name="address"]').value = autofillUser.address;
    if (autofillUser.city) {
        const citySelect = form.querySelector('select[name="city"]');
        if (citySelect) citySelect.value = autofillUser.city;
    }
    showToast('Coordonnées chargées depuis votre profil !', 'success');
}

function togglePay(input) {
    document.querySelectorAll('.pay-card').forEach(c => c.classList.remove('active'));
    input.closest('.pay-card').classList.add('active');
    const cardFields = document.getElementById('card-fields');
    if (cardFields) {
        cardFields.style.display = input.value === 'card' ? 'block' : 'none';
    }
}
</script>

<script src="https://js.stripe.com/v3/"></script>
<script>
(function() {
    const PUBLISHABLE_KEY = <?= json_encode(STRIPE_PUBLISHABLE_KEY) ?>;
    const AMOUNT_EUR_CENTS = <?= round(($total / 10.8) * 100) ?>;

    if (!PUBLISHABLE_KEY) return;

    const stripe = Stripe(PUBLISHABLE_KEY);
    const elements = stripe.elements();

    const cardElement = elements.create('card', {
        style: {
            base: {
                fontFamily: 'system-ui, sans-serif',
                fontSize: '15px',
                color: '#1a1209',
                '::placeholder': { color: '#b0a090' }
            },
            invalid: { color: '#c0392b' }
        },
        hidePostalCode: true
    });

    cardElement.mount('#stripe-card-element');

    const errDiv = document.getElementById('stripe-card-errors');
    cardElement.on('change', e => {
        errDiv.textContent = e.error ? e.error.message : '';
        document.getElementById('stripe-card-element').style.borderColor = e.error ? '#c0392b' : '';
    });

    let intentReady = false;
    let clientSecret = null;
    let pendingOrderData = null;

    const form = document.getElementById('mainCheckoutForm');
    if (!form) return;

    form.addEventListener('submit', async function(e) {
        const payVal = form.querySelector('[name=payment]:checked')?.value;
        if (payVal !== 'card') return;

        e.preventDefault();
        const btn = form.querySelector('#confirmBtn');
        const btnLabel = btn ? btn.querySelector('.confirm-btn-label') : null;
        const originalLabel = 'Confirmer et Commander';

        function setLoading(loading) {
            if (!btn) return;
            btn.disabled = loading;
            if (btnLabel) btnLabel.textContent = loading ? 'Traitement en cours...' : originalLabel;
            btn.classList.toggle('loading', loading);
        }

        setLoading(true);
        errDiv.textContent = '';

        const fields = new FormData(form);
        const body = new URLSearchParams([...fields.entries()]);

        let secret = clientSecret;

        if (!secret) {
            const intentRes = await fetch('actions/stripe_intent.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `amount=${AMOUNT_EUR_CENTS}&order_id=0`
            });
            const intentData = await intentRes.json();

            if (intentData.error) {
                errDiv.textContent = intentData.error;
                setLoading(false);
                return;
            }
            secret = intentData.client_secret;
            clientSecret = secret;
        }

        const { paymentIntent, error } = await stripe.confirmCardPayment(secret, {
            payment_method: {
                card: cardElement,
                billing_details: {
                    name: form.querySelector('[name=name]')?.value || '',
                    email: form.querySelector('[name=email]')?.value || ''
                }
            }
        });

        if (error) {
            errDiv.textContent = error.message;
            setLoading(false);
            clientSecret = null;
            return;
        }

        document.getElementById('stripe_payment_intent_id').value = paymentIntent.id;
        form.submit();
    });
})();
</script>

